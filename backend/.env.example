# =============================================================================
# Employee Attendance System - Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://attendance_user:attendance_pass@localhost:5432/attendance_db

# --- JWT Secrets (use strong random strings, min 32 characters) ---
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Timezone (DO NOT CHANGE — system uses Asia/Bangkok throughout) ---
TZ=Asia/Bangkok

# --- CORS ---
# Development: http://localhost:5173
# Production: https://your-domain.com
CORS_ORIGIN=http://localhost:5173

# --- Rate Limiting ---
# Login: max 5 attempts per 15 minutes per IP
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
# Check-in/out: max 10 attempts per minute per IP
RATE_LIMIT_CHECKIN_MAX=10
RATE_LIMIT_CHECKIN_WINDOW_MS=60000

# --- Logging ---
# Levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# --- bcrypt ---
BCRYPT_ROUNDS=12
